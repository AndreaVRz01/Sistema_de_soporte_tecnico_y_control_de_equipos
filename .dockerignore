# =============================================================================
# .dockerignore — SIGA Enterprise
# Excluye archivos innecesarios del contexto de build de Docker.
# =============================================================================

# ----- Control de versiones -----
.git
.gitignore
.gitattributes
.github

# ----- Dependencias locales (se instalan en el build) -----
/vendor
/node_modules

# ----- Assets compilados por Vite -----
/public/build
/public/hot

# ----- Archivos de entorno sensibles -----
.env.local
.env.*.local
.env.testing
.env.staging
.env.backup

# ----- Base de datos local SQLite -----
/database/database.sqlite*

# ----- Logs y caché local -----
/storage/logs/*.log
/storage/framework/cache/data/*
/storage/framework/sessions/*
/storage/framework/views/*
/bootstrap/cache/*.php

# ----- Archivos de desarrollo y testing -----
/tests
/phpunit.xml
phpunit.xml.dist

# ----- Herramientas de desarrollo -----
/.pint.json
/psalm.xml
/.phpactor.json

# ----- Documentación interna -----
/docs
*.md
!README.md

# ----- Docker files (evitar recursión, pero PERMITIR la carpeta docker/) -----
Dockerfile*
compose.yaml
docker-compose*.yml
.dockerignore
!docker/**

# ----- IDEs y editores -----
.vscode
.idea
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ----- Node / Frontend -----
package.json
package-lock.json
vite.config.js
postcss.config.js
tailwind.config.js

# ----- CI/CD -----
.travis.yml
.circleci
Jenkinsfile

# ----- Scripts (no ignorar los de docker/) -----
*.sh
!docker/app/entrypoint.sh

# ----- Archivos temporales -----
/tmp
*.tmp
*.bak
*.orig
